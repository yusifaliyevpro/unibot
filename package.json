{
  "name": "unibot",
  "version": "1.0.0",
  "description": "A NestJS-based WhatsApp bot with AI, scheduling, and utility integrations.",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Yusif Aliyev",
    "email": "yusifaliyevpro@gmail.com",
    "url": "https://yusifaliyevpro.com"
  },
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "db:push": "prisma db push && prisma generate",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start": "node dist/main",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "greenly",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@adobe/pdfservices-node-sdk": "4.1.0",
    "@googleapis/calendar": "20.1.0",
    "@neondatabase/serverless": "1.2.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/schedule": "12.0.2",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@prisma/adapter-neon": "7.9.1",
    "ai": "7.0.150",
    "axios": "1.20.0",
    "baileys": "7.0.0-rc14",
    "dotenv": "18.0.9",
    "globals": "17.13.0",
    "node-webpmux": "3.2.1",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "wikipedia": "2.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.10",
    "@nestjs/schematics": "12.0.10",
    "@prisma/client": "7.9.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.20",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "greenly": "1.2.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "prisma": "7.9.1",
    "source-map-support": "0.5.21",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.15.0 <13",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.12.1",
    "pnpm": ">=12.15.0 <13"
  }
}
